{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block description %}Parroquia Transfiguración del Señor — Grupo de Biblia. Un recorrido por las cartas de San Pablo a los Corintios.{% endblock %}

{% block content %}

<section class="hero wrap">
  <div class="hero-inner">
    <div class="eyebrow on-dark">Grupo de Biblia</div>
    <p class="hero-kicker">Cartas que siguen hablando hoy.</p>
    <h1>Cartas a los <em>Corintios</em></h1>
    <p class="hero-lede">Un recorrido pausado por las cartas de San Pablo a la comunidad de Corinto: preguntas, dones, amor y esperanza que todavía nos hablan.</p>
  </div>
</section>

<section class="section wrap">
  <div class="intro">
    <div class="eyebrow">Elige una carta</div>
    <h2>Nuestros estudios</h2>
    <p class="muted">Cada carta se vive como un pequeño recorrido, con temas para conversar en comunidad.</p>
  </div>

  <div class="letters">
    {% for letter in letters %}
      {% if letter.available %}
      <a class="letter-card" href="{{ letter.url }}">
        <span class="letter-numeral">{{ letter.numeral }}</span>
        <span class="letter-title">{{ letter.title }}</span>
        <span class="muted">{{ letter.description }}</span>
      </a>
      {% else %}
      <div class="letter-card disabled">
        <span class="letter-numeral">{{ letter.numeral }}</span>
        <span class="letter-title">{{ letter.title }}</span>
        <span class="muted">{{ letter.description }}</span>
        <span class="badge-soon">Próximamente</span>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="section wrap">
  <div class="intro">
    <div class="eyebrow">Vida parroquial</div>
    <h2>Calendario</h2>
    <p class="muted">Fechas litúrgicas destacadas y la colecta mensual de Cáritas, de septiembre a diciembre de 2026.</p>
  </div>

  <div class="calendar" id="calendar" data-start="{{ calendarStart }}" data-end="{{ calendarEnd }}">
    <div class="calendar-head">
      <button type="button" class="calendar-nav" id="calendar-prev" aria-label="Mes anterior">‹</button>
      <div class="calendar-title" id="calendar-title"></div>
      <button type="button" class="calendar-nav" id="calendar-next" aria-label="Mes siguiente">›</button>
    </div>
    <div class="calendar-weekdays">
      <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
    </div>
    <div class="calendar-grid" id="calendar-grid"></div>
    <div class="calendar-legend">
      <span class="legend-item"><span class="legend-dot"></span>Fecha litúrgica</span>
      <span class="legend-item"><span class="legend-dot legend-dot--caritas"></span>Cáritas</span>
    </div>
  </div>

  <div class="detail calendar-detail" aria-live="polite">
    <strong id="calendar-detail-title">Selecciona un día marcado</strong>
    <div id="calendar-detail-text" class="muted">Los días con un punto tienen una fecha litúrgica o la colecta de Cáritas. Tócalos para ver el detalle.</div>
  </div>

  <script type="application/json" id="calendar-data">{{ calendarEvents|json_encode|raw }}</script>
</section>

{% endblock %}
