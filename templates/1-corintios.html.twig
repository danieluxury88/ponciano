{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block description %}Primera Carta a los Corintios — Grupo de Biblia, Parroquia Transfiguración del Señor.{% endblock %}

{% block content %}

<section class="hero center wrap">
  <div class="hero-inner">
    <span class="hero-badge"><img src="/img/mark.png" alt="Parroquia Transfiguración del Señor"></span>
    <div class="eyebrow on-dark">Grupo de Biblia · Primera Carta a los Corintios</div>
    <p class="hero-verse">Todo lo que hagan,<br><em>háganlo con amor.</em></p>
    <span class="hero-ref">{{ verse }}</span>
    <div class="hero-note">
      <p>Gracias por cada pregunta, cada reflexión, cada momento de escucha y cada experiencia compartida durante este camino.</p>
    </div>
  </div>
</section>

<section class="section wrap two-col">
  <div>
    <div class="eyebrow">Corinto · siglo I</div>
    <h2>Una comunidad real.</h2>
    <p class="muted">Pablo escribió a cristianos con dones, diferencias, preguntas, dificultades y esperanza. No a una comunidad perfecta, sino a una comunidad llamada a crecer en Cristo.</p>
  </div>
  <div class="lead-card">
    <div class="eyebrow">Nuestra comunidad · hoy</div>
    <p>Siglos después, nosotros también nos reunimos alrededor de la misma Palabra.</p>
  </div>
</section>

<section class="section wrap">
  <div class="intro">
    <div class="eyebrow">Corinto en el mapa</div>
    <h2>Una ciudad en el cruce de caminos</h2>
    <p class="muted">Corinto está en Grecia, junto al istmo que une el Peloponeso con el resto del país: un cruce natural entre el mar Jónico y el mar Egeo que la convirtió en un puerto comercial clave en tiempos de Pablo.</p>
  </div>

  <div class="context-grid">
    <div class="context-map">
      <iframe
        title="Mapa de Corinto, Grecia"
        src="https://www.openstreetmap.org/export/embed.html?bbox=22.75%2C37.80%2C23.10%2C38.05&amp;layer=mapnik&amp;marker=37.9407%2C22.9307"
        loading="lazy"
        width="100%"
        height="280"
      ></iframe>
      <p class="context-map-caption">Corinto, Grecia — a orillas del golfo que lleva su nombre.</p>
    </div>

    <ol class="timeline">
      <li class="timeline-item">
        <span class="timeline-year">c. 51-52 d.C.</span>
        <strong>Pablo llega a Corinto</strong>
        <p>Funda la comunidad durante una larga estancia de año y medio (Hechos 18,1-11).</p>
      </li>
      <li class="timeline-item">
        <span class="timeline-year">c. 52-54 d.C.</span>
        <strong>Pablo continúa su misión en Éfeso</strong>
        <p>La comunidad de Corinto sigue creciendo, entre logros y divisiones.</p>
      </li>
      <li class="timeline-item">
        <span class="timeline-year">c. 54-55 d.C.</span>
        <strong>Se escribe 1 Corintios</strong>
        <p>Desde Éfeso, Pablo responde por carta a las preguntas y conflictos que le llegan de la comunidad.</p>
      </li>
      <li class="timeline-item">
        <span class="timeline-year">Hoy</span>
        <strong>La carta sigue hablando</strong>
        <p>Sus llamados a la unidad, el amor y la esperanza siguen resonando en comunidades como la nuestra.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section wrap">
  <div class="intro">
    <div class="eyebrow">Lo que nos deja 1 Corintios</div>
    <h2>Seis ideas para llevar con nosotros</h2>
    <p class="muted">Toca cada tema para recordar una de las grandes invitaciones de la carta.</p>
  </div>

  <div class="topics">
    {% for topic in topics %}
    <button class="topic" type="button" aria-pressed="{{ loop.first ? 'true' : 'false' }}" data-title="{{ topic.title }}" data-text="{{ topic.text }}">{{ topic.icon|raw }}<span class="name">{{ topic.title }}</span></button>
    {% endfor %}
  </div>

  <div class="detail" aria-live="polite">
    <strong id="topic-title">{{ topics[0].title }}</strong>
    <div id="topic-text" class="muted" style="margin-top:6px">{{ topics[0].text }}</div>
  </div>
</section>

<section class="section wrap center">
  <svg class="glyph" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2C12 7.5 7.5 12 2 12C7.5 12 12 16.5 12 22C12 16.5 16.5 12 22 12C16.5 12 12 7.5 12 2Z" fill="currentColor"/></svg>
  <div class="bigline">Terminamos una carta,<br>pero no terminamos el camino.</div>
  <p class="muted" style="max-width:680px;margin:18px auto 0">Que lo aprendido se transforme en una manera más profunda de amar a Dios, servir a los demás y construir comunidad.</p>
</section>

<section class="section wrap">
  <div class="message-card">
    <div class="eyebrow on-dark">Un mensaje para llevar</div>
    <div id="message" aria-live="polite">{{ messages[0].text }}</div>
    <span id="message-ref" class="message-ref">{{ messages[0].ref }}</span>
    <button id="new-message" class="action" type="button">Descubrir otro mensaje</button>
  </div>
  <script type="application/json" id="messages-data">{{ messages|json_encode|raw }}</script>
</section>

<footer class="page-footer wrap">
  <div class="thanks">Gracias por caminar juntos en la Palabra.</div>
  <p class="muted">Por cada encuentro, cada pregunta, cada testimonio y cada momento compartido. Que el Señor haga fecundo lo que hemos recibido.</p>
  <div class="eyebrow" style="margin-top:24px">Primera Carta a los Corintios · Grupo de Biblia</div>
</footer>

{% endblock %}
